# Gestionado por platform-proxmox (roles/network). Los cambios hechos a mano o desde
# la UI se pierden en el siguiente `make apply`: cambia el inventario.
# Nodo pve03 (pve03.pve.example.internal)

auto lo
iface lo inet loopback

iface nic0 inet manual
iface nic1 inet manual

auto bond0
iface bond0 inet manual
    bond-slaves nic0 nic1
    bond-miimon 100
    bond-mode active-backup

auto vmbr0
iface vmbr0 inet static
    address 10.30.0.13/24
    gateway 10.30.0.1
    bridge-ports bond0
    bridge-stp off
    bridge-fd 0
    bridge-vlan-aware yes
    bridge-vids 2-4094
    mtu 1500

# Red dedicada de corosync (link1)
auto nic2
iface nic2 inet static
    address 10.31.0.13/24

source /etc/network/interfaces.d/*
