# Contenedor con proxmox-auto-install-assistant, para quien no trabaja en Debian
# (lo usan install/make-iso.sh y el CI para validar los answer.toml).
#   docker build -t platform-proxmox-assistant -f install/Dockerfile.assistant install/
# El keyring de Proxmox se comprueba por sha256 (fijado el 15-oct-2026).
FROM debian:trixie-slim
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl \
 && curl -fsSL https://enterprise.proxmox.com/debian/proxmox-archive-keyring-trixie.gpg \
      -o /usr/share/keyrings/proxmox-archive-keyring.gpg \
 && echo "136673be77aba35dcce385b28737689ad64fd785a797e57897589aed08db6e45  /usr/share/keyrings/proxmox-archive-keyring.gpg" \
      | sha256sum -c - \
 && echo "deb [signed-by=/usr/share/keyrings/proxmox-archive-keyring.gpg] http://download.proxmox.com/debian/pve trixie pve-no-subscription" \
      > /etc/apt/sources.list.d/pve.list \
 && apt-get update \
 && apt-get install -y --no-install-recommends proxmox-auto-install-assistant xorriso \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /work
ENTRYPOINT ["proxmox-auto-install-assistant"]
