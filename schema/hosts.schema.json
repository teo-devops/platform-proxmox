{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/teo-devops/platform-proxmox/schema/hosts.schema.json",
  "title": "platform-proxmox: inventario de nodos (hosts.yml)",
  "description": "Referencia: docs/inventario.md",
  "type": "object",
  "required": ["all"],
  "additionalProperties": false,
  "properties": {
    "all": {
      "type": "object",
      "required": ["children"],
      "additionalProperties": false,
      "properties": {
        "children": {
          "type": "object",
          "required": ["pve_nodes"],
          "properties": {
            "pve_nodes": {
              "type": "object",
              "required": ["hosts"],
              "additionalProperties": false,
              "properties": {
                "hosts": {
                  "type": "object",
                  "minProperties": 1,
                  "propertyNames": {"pattern": "^[a-z][a-z0-9-]{0,62}$"},
                  "additionalProperties": {"$ref": "#/$defs/node"}
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "ipv4": {"type": "string", "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}$"},
    "ifname": {"type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9._-]{0,14}$"},
    "node": {
      "type": "object",
      "required": ["ansible_host", "pve_nic", "pve_disks"],
      "additionalProperties": false,
      "properties": {
        "ansible_host": {"$ref": "#/$defs/ipv4", "description": "IP de gestion del nodo (la del bridge)"},
        "ansible_user": {"type": "string"},
        "pve_nic": {"$ref": "#/$defs/ifname", "description": "Interfaz del bridge: una NIC fisica o el bond de pve_bond"},
        "pve_mac": {"type": "string", "pattern": "^([0-9a-fA-F]{2}:){5}[0-9a-fA-F]{2}$"},
        "pve_bond": {
          "type": "object",
          "required": ["slaves"],
          "additionalProperties": false,
          "properties": {
            "slaves": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/ifname"}},
            "mode": {"enum": ["active-backup", "802.3ad", "balance-alb"]}
          }
        },
        "pve_disks": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9]{1,31}$"},
          "description": "Discos del sistema (sin /dev/)"
        },
        "pve_zfs_raid": {"enum": ["raid0", "raid1", "raid10", "raidz-1", "raidz-2", "raidz-3"]},
        "pve_corosync_link1": {
          "type": "object",
          "required": ["nic", "ip"],
          "additionalProperties": false,
          "properties": {"nic": {"$ref": "#/$defs/ifname"}, "ip": {"$ref": "#/$defs/ipv4"}}
        },
        "pve_expect": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cpu_threads": {"type": "integer", "minimum": 1},
            "ram_gib": {"type": "integer", "minimum": 1},
            "disk_gib": {"type": "integer", "minimum": 1}
          }
        },
        "bmc": {
          "type": "object",
          "required": ["host"],
          "additionalProperties": false,
          "properties": {"host": {"type": "string"}, "interface": {"enum": ["lanplus", "lan"]}}
        }
      }
    }
  }
}
